<Page x:Class="HindPharma.Windows.Views.DailyCallingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Padding="28" Spacing="12">
  <TextBlock Text="Today's Medicals" FontSize="28" FontWeight="SemiBold"/>
  <TextBlock Text="Tap Call to record isCall. The server enforces the cooldown." Opacity="0.7"/>
  <ListView x:Name="CallingList"><ListView.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,4"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><StackPanel><TextBlock Text="{Binding Name}" FontSize="17"/><TextBlock Text="{Binding Phone}"/><TextBlock Text="{Binding Area}" Opacity="0.7"/></StackPanel><Button Grid.Column="1" Content="Call" Tag="{Binding Id}" Click="Call_Click"/><ComboBox Grid.Column="2" Width="150" Tag="{Binding Id}" SelectionChanged="Status_Changed"><ComboBoxItem Content="Select status" Tag="none"/><ComboBoxItem Content="Picked" Tag="picked"/><ComboBoxItem Content="Not Picked" Tag="not_picked"/></ComboBox></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
  <InfoBar x:Name="Info" IsOpen="False" IsClosable="True"/>
 </StackPanel>
</Page>
