<Page x:Class="HindPharma.Windows.Views.ProductListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Padding="28" Spacing="12">
  <TextBlock Text="Product List" FontSize="28" FontWeight="SemiBold"/>
  <TextBlock x:Name="MedicalLabel" Opacity="0.7"/>
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="SearchBox" PlaceholderText="Search products"/><Button Content="Search" Click="Search_Click"/></Grid>
  <ListView x:Name="ProductsList"><ListView.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,3"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><StackPanel><TextBlock Text="{Binding Name}" FontSize="17"/><TextBlock Text="{Binding Company}" Opacity="0.7"/><TextBlock Text="{Binding MRP}" Opacity="0.7"/></StackPanel><NumberBox Grid.Column="1" Width="100" Minimum="1" Maximum="9999" SmallChange="1" Value="1" x:Name="QuantityBox"/><Button Grid.Column="2" Content="Add" Tag="{Binding Id}" Click="Add_Click"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
  <Button Content="Continue to Final Order" Click="Continue_Click" HorizontalAlignment="Left"/>
  <Button Content="Back to Medical List" Click="Back_Click" HorizontalAlignment="Left"/>
  <InfoBar x:Name="Info" IsOpen="False" IsClosable="True"/>
 </StackPanel>
</Page>
