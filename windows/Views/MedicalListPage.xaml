<Page x:Class="HindPharma.Windows.Views.MedicalListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Padding="28" Spacing="12">
  <TextBlock Text="Medical List" FontSize="28" FontWeight="SemiBold"/>
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="SearchBox" PlaceholderText="Search medical or area" KeyDown="Search_KeyDown"/><Button Content="Search" Click="Search_Click"/></Grid>
  <ListView x:Name="MedicalList"><ListView.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18"/><TextBlock Text="{Binding Area}" Opacity="0.7"/><TextBlock Text="{Binding Phone}" Opacity="0.7"/></StackPanel><Button Grid.Column="1" Content="Select" Tag="{Binding Id}" Click="Select_Click"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
  <InfoBar x:Name="Info" IsOpen="False" IsClosable="True"/>
 </StackPanel>
</Page>
