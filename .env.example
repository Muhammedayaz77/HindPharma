# PharmaFlow / Hind HealthCare database configuration
# LOCAL DEVELOPMENT / TESTING
DATABASE_URL=sqlite:///./hind_pharma.db

# PRODUCTION (ShrotiHost MySQL)
# Replace the values below in the hosting environment; do not commit real credentials.
# DATABASE_URL=mysql+pymysql://MYSQL_USER:MYSQL_PASSWORD@MYSQL_HOST:3306/MYSQL_DATABASE

# Runtime environment
HIND_PHARMA_ENV=development

# Authentication
HIND_PHARMA_AUTH_SECRET=replace-with-a-long-random-secret
